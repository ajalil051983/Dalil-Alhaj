<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KhayratAlhaj.Pages.QuranPackagePage"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <Label x:Name="IntroLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColorLight}, Dark={StaticResource PrimaryTextColorDark}}" />

            <Label x:Name="DescriptionLabel"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColorLight}, Dark={StaticResource SecondaryTextColorDark}}" />

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D4C48A, Dark=#7A6E3F}"
                    StrokeShape="RoundRectangle 10"
                    Padding="12"
                    Background="{AppThemeBinding Light=#FFF8E7, Dark=#2D271E}">
                <VerticalStackLayout Spacing="10">
                    <Button x:Name="DownloadInstallButton"
                            Clicked="OnDownloadAndInstallClicked" />
                </VerticalStackLayout>
            </Border>

            <ProgressBar x:Name="InstallProgressBar"
                         Progress="0"
                         IsVisible="False" />

            <Label x:Name="StatusLabel"
                   Text=""
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColorLight}, Dark={StaticResource SecondaryTextColorDark}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
