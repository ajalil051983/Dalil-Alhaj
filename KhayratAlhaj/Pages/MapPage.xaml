<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:res="clr-namespace:KhayratAlhaj.Resources.Localization"
             x:Class="KhayratAlhaj.Pages.MapPage"
             Title="{x:Static res:AppResources.Map}"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1C1C1E}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" 
                BackgroundColor="{AppThemeBinding Light=#2C3E50, Dark=#1E1E1E}" 
                StrokeShape="Rectangle"
                StrokeThickness="0"
                Padding="20"
                Margin="0">
            <VerticalStackLayout Spacing="5">
                <Label Text="{x:Static res:AppResources.Map}" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <Label Text="{x:Static res:AppResources.MapRoute}" 
                       FontSize="14"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Map with Share Location Button, Compass, and Popup -->
        <Grid Grid.Row="1">
            <!-- OpenStreetMap using Mapsui -->
            <mapsui:MapControl x:Name="HajjMapControl" 
                               AutomationId="MapControlID" 
                               IsVisible="True"
                               Info="OnMapInfo" />
            
            <!-- Walking/Driving Route Toggle -->
            <Border HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Margin="20"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C3E50}"
                    StrokeThickness="0"
                    Padding="4"
                    Shadow="{Shadow Brush=Black, Opacity=0.3, Radius=5, Offset='0,2'}">
                <HorizontalStackLayout Spacing="4">
                    <Button x:Name="WalkingButton"
                            Text="{x:Static res:AppResources.Walking}"
                            Clicked="OnWalkingClicked"
                            BackgroundColor="{AppThemeBinding Light=#3498DB, Dark=#2980B9}"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="36"
                            FontSize="12"
                            FontAttributes="Bold"
                            Padding="12,0" />
                    <Button x:Name="DrivingButton"
                            Text="{x:Static res:AppResources.Driving}"
                            Clicked="OnDrivingClicked"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#7F8C8D, Dark=#BDC3C7}"
                            CornerRadius="16"
                            HeightRequest="36"
                            FontSize="12"
                            FontAttributes="Bold"
                            Padding="12,0" />
                </HorizontalStackLayout>
            </Border>

            <!-- Route Info Overlay -->
            <Border x:Name="RouteInfoPanel"
                    IsVisible="False"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,70,0,0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFFEE, Dark=#2C3E50EE}"
                    StrokeThickness="0"
                    Padding="12,6"
                    Shadow="{Shadow Brush=Black, Opacity=0.2, Radius=4, Offset='0,2'}">
                <HorizontalStackLayout Spacing="10">
                    <Label x:Name="RouteDistanceLabel" 
                           FontSize="13" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#2C3E50, Dark=#FFFFFF}"
                           VerticalOptions="Center" />
                    <Label Text="·" FontSize="16" TextColor="{AppThemeBinding Light=#BDC3C7, Dark=#7F8C8D}" VerticalOptions="Center" />
                    <Label x:Name="RouteETALabel" 
                           FontSize="13" 
                           TextColor="{AppThemeBinding Light=#34495E, Dark=#ECF0F1}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Qibla Compass Overlay -->
            <Border x:Name="CompassContainer"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="20"
                    WidthRequest="60"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 30"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C3E50}"
                    StrokeThickness="0"
                    Shadow="{Shadow Brush=Black, Opacity=0.3, Radius=5, Offset='0,2'}">
                <Grid>
                    <Label Text="🕋" 
                           FontSize="24" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           x:Name="CompassNeedle" />
                    <Label Text="{x:Static res:AppResources.Qibla}" 
                           FontSize="10" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#2C3E50, Dark=#FFFFFF}"
                           HorizontalOptions="Center" 
                           VerticalOptions="End" 
                           Margin="0,0,0,5"/>
                </Grid>
            </Border>

            <!-- My Location Button -->
            <Button x:Name="MyLocationButton"
                    AutomationId="MyLocationButtonID"
                    Text="📍"
                    Clicked="OnMyLocationClicked"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C3E50}"
                    TextColor="{AppThemeBinding Light=#2C3E50, Dark=#FFFFFF}"
                    CornerRadius="25"
                    HeightRequest="50"
                    WidthRequest="50"
                    FontSize="22"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20,20,20,80"
                    Shadow="{Shadow Brush=Black, Opacity=0.3, Radius=10, Offset='0,4'}" />

            <!-- Share Location Button -->
            <Button x:Name="ShareLocationButton"
                    Text="{x:Static res:AppResources.ShareLocation}"
                    Clicked="OnShareLocationClicked"
                    BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    WidthRequest="180"
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20"
                    Shadow="{Shadow Brush=Black, Opacity=0.3, Radius=10, Offset='0,4'}" />

            <!-- Location Info Popup Overlay -->
            <Border x:Name="LocationPopup"
                    IsVisible="False"
                    VerticalOptions="End"
                    Margin="20,20,20,90"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C3E50}"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="0"
                    Shadow="{Shadow Brush=Black, Opacity=0.3, Radius=10, Offset='0,4'}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" Padding="15">
                    <Label x:Name="PopupTitle" 
                           Grid.Row="0" Grid.Column="0"
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#2C3E50, Dark=#FFFFFF}" />
                    
                    <Button Text="✕" 
                            Grid.Row="0" Grid.Column="1"
                            BackgroundColor="Transparent" 
                            TextColor="{AppThemeBinding Light=#7F8C8D, Dark=#BDC3C7}"
                            FontSize="16"
                            Padding="0"
                            WidthRequest="30" HeightRequest="30"
                            Clicked="OnClosePopupClicked" />

                    <!-- Location description -->
                    <Label x:Name="PopupDescription"
                           Grid.Row="1" Grid.ColumnSpan="2"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#7F8C8D, Dark=#BDC3C7}"
                           Margin="0,4,0,0" />

                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="15" Margin="0,10,0,15">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="🚶" FontSize="14" VerticalOptions="Center" />
                            <Label x:Name="PopupDistance" 
                                   FontSize="14" 
                                   TextColor="{AppThemeBinding Light=#34495E, Dark=#ECF0F1}" 
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="⏱️" FontSize="14" VerticalOptions="Center" />
                            <Label x:Name="PopupETA" 
                                   FontSize="14" 
                                   TextColor="{AppThemeBinding Light=#34495E, Dark=#ECF0F1}" 
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <Button x:Name="ViewGuideButton"
                            Grid.Row="3" Grid.ColumnSpan="2"
                            Text="{x:Static res:AppResources.ViewGuide}"
                            BackgroundColor="{AppThemeBinding Light=#27AE60, Dark=#2ECC71}"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="40"
                            Clicked="OnViewGuideClicked" />

                    <!-- Guide summary (shown after tapping View Guide) -->
                    <Label x:Name="GuideSummaryLabel"
                           Grid.Row="4" Grid.ColumnSpan="2"
                           FontSize="13"
                           MaxLines="5"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light=#34495E, Dark=#ECF0F1}"
                           Margin="0,8,0,0"
                           IsVisible="False" />

                    <!-- Read More button (shown after tapping View Guide) -->
                    <Button x:Name="ReadMoreButton"
                            Grid.Row="5" Grid.ColumnSpan="2"
                            Text="{x:Static res:AppResources.ReadMore}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#3498DB, Dark=#5DADE2}"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="10"
                            HeightRequest="40"
                            Margin="0,4,0,0"
                            IsVisible="False"
                            Clicked="OnReadMoreClicked" />
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
