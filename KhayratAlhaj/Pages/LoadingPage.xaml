<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:KhayratAlhaj.Resources.Localization"
             x:Class="KhayratAlhaj.Pages.LoadingPage"
             BackgroundColor="{StaticResource HeaderBackgroundColor}">

    <Grid>
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="24"
            Padding="30,0">

            <!-- Kaaba Icon -->
            <Image Source="kaaba_icon"
                   WidthRequest="180"
                   HeightRequest="180"
                   HorizontalOptions="Center"
                   Aspect="AspectFit" />

            <!-- Title -->
            <Label x:Name="TitleLabel"
                   Text="{x:Static res:AppResources.AppTitle}"
                   FontSize="42"
                   FontAttributes="Bold"
                   TextColor="#FFD700"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Subtitle -->
            <Label x:Name="SubtitleLabel"
                   Text="{x:Static res:AppResources.AppSubtitle}"
                   FontSize="24"
                   TextColor="#ECF0F1"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Loading indicator -->
            <ActivityIndicator IsRunning="True"
                               Color="#FFD700"
                               WidthRequest="44"
                               HeightRequest="44"
                               Margin="0,24,0,0" />

        </VerticalStackLayout>

        <!-- Copyright Footer -->
        <Label Text="{x:Static res:AppResources.Copyright}"
               FontSize="16"
               TextColor="#95A5A6"
               VerticalOptions="End"
               HorizontalOptions="Center"
               Margin="0,0,0,30" />
    </Grid>

</ContentPage>
