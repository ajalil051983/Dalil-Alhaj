<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KhayratAlhaj.Pages"
             x:Class="KhayratAlhaj.Pages.QuranReaderPage"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="14,14,14,0" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Text="▶"
                    WidthRequest="44"
                    HeightRequest="44"
                    FontSize="18"
                    Clicked="OnPrevSurahClicked" />

            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Label x:Name="SurahTitleLabel"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColorLight}, Dark={StaticResource PrimaryTextColorDark}}" />
                <Label x:Name="SurahSubtitleLabel"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColorLight}, Dark={StaticResource SecondaryTextColorDark}}" />
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="◀"
                    WidthRequest="44"
                    HeightRequest="44"
                    FontSize="18"
                    Clicked="OnNextSurahClicked" />
        </Grid>

        <Border Grid.Row="1"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#D4C48A, Dark=#7A6E3F}"
                Background="{AppThemeBinding Light=#FDF6E3, Dark=#25201A}"
                StrokeShape="RoundRectangle 12"
                Padding="0"
                Margin="0,4,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0"
                        Background="{AppThemeBinding Light=#0F5132, Dark=#134E30}"
                        Stroke="{AppThemeBinding Light=#B48A2E, Dark=#8A6A22}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8"
                        Margin="12,10,12,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="۩"
                               FontSize="20"
                               TextColor="#F8E9BA"
                               VerticalTextAlignment="Center" />
                        <Label Grid.Column="1"
                               x:Name="MushafSurahNameLabel"
                               TextColor="#F8E9BA"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               FontFamily="OpenSansSemibold"
                               LineHeight="1.2" />
                        <Label Grid.Column="2"
                               Text="۩"
                               FontSize="20"
                               TextColor="#F8E9BA"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="8,0">
                    <CarouselView x:Name="PageCarousel"
                                  IsSwipeEnabled="True"
                                  PositionChanged="OnCarouselPositionChanged"
                                  Loop="False"
                                  PeekAreaInsets="6">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="local:QuranPageAssetItem">
                                <Grid Padding="6,8">
                                    <Border Stroke="{AppThemeBinding Light=#D4C48A, Dark=#7A6E3F}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10"
                                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#111111}">
                                        <Grid>
                                            <Image Source="{Binding PageImagePath}"
                                                   Aspect="AspectFit"
                                                   Margin="6" />

                                            <VerticalStackLayout IsVisible="{Binding IsImageMissing}"
                                                                 HorizontalOptions="Center"
                                                                 VerticalOptions="Center"
                                                                 Padding="20"
                                                                 Spacing="10">
                                                <Label Text="الصفحة غير متوفرة"
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{AppThemeBinding Light=#5B4210, Dark=#F1D98A}" />
                                                <Label Text="قم بتنزيل حزمة صفحات المصحف لإظهار هذه الصفحة."
                                                       FontSize="13"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{AppThemeBinding Light=#7A6E3F, Dark=#C8B77D}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <Border x:Name="MissingPackageBorder"
                            IsVisible="False"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Background="{AppThemeBinding Light=#FFF7E2, Dark=#302715}"
                            Stroke="{AppThemeBinding Light=#D4C48A, Dark=#7A6E3F}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="18,14"
                            Margin="20">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="حزمة المصحف غير متوفرة"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#5B4210, Dark=#F1D98A}" />
                            <Label Text="ضع ملفات الصفحات في مجلد الحزمة المحلي ثم أعد المحاولة."
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#7A6E3F, Dark=#C8B77D}" />
                            <Button Text="إعادة التحقق"
                                    Clicked="OnRetryPackageClicked"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Background="{AppThemeBinding Light=#F2E7C6, Dark=#3A3225}"
                        Stroke="{AppThemeBinding Light=#B48A2E, Dark=#8A6A22}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,6"
                        Margin="12,4,12,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                        <Label Grid.Column="0"
                               Text="◆"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#5B4210, Dark=#F1D98A}" />
                        <Label Grid.Column="1"
                               x:Name="MushafFooterLabel"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#5B4210, Dark=#F1D98A}" />
                        <Label Grid.Column="2"
                               Text="◆"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#5B4210, Dark=#F1D98A}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              ColumnSpacing="6"
              Padding="4,8">
            <Button Text="◀"
                    WidthRequest="46"
                    HeightRequest="38"
                    FontSize="14"
                    Padding="0"
                    Clicked="OnNextPageClicked" />
            <Button Grid.Column="1"
                    Text="▶"
                    WidthRequest="46"
                    HeightRequest="38"
                    FontSize="14"
                    Padding="0"
                    Clicked="OnPreviousPageClicked" />
            <Button Grid.Column="2"
                    Text="🔖"
                    Clicked="OnBookmarksClicked"
                    WidthRequest="46"
                    HeightRequest="38"
                    FontSize="16"
                    Padding="0" />
            <Button Grid.Column="3"
                    x:Name="PageBookmarkButton"
                    Text="☆"
                    FontSize="16"
                    WidthRequest="46"
                    HeightRequest="38"
                    Padding="0"
                    Clicked="OnPageBookmarkClicked" />

            <Label Grid.Column="4"
                   x:Name="PageIndicatorLabel"
                   Text="0 / 0"
                   FontAttributes="Bold"
                   FontSize="13"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColorLight}, Dark={StaticResource PrimaryTextColorDark}}" />

            <Entry Grid.Column="5"
                   x:Name="AyahJumpEntry"
                   Placeholder="رقم الآية"
                   WidthRequest="86"
                   HeightRequest="38"
                   HorizontalTextAlignment="Center"
                   Keyboard="Numeric"
                   ReturnType="Go"
                   Completed="OnAyahJumpCompleted" />
        </Grid>

        <Grid x:Name="LoadingOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#88000000">
            <Border VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light=#FDF6E3, Dark=#25201A}"
                    Stroke="{AppThemeBinding Light=#D4C48A, Dark=#7A6E3F}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="32,24"
                    MinimumWidthRequest="180">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       WidthRequest="48"
                                       HeightRequest="48"
                                       Color="{AppThemeBinding Light=#0F5132, Dark=#4CAF80}"
                                       HorizontalOptions="Center" />
                    <Label Text="جاري تجهيز صفحات السورة..."
                           FontSize="15"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#5B4210, Dark=#F1D98A}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
